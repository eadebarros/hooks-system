# Chave da API da Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Modelo do Claude usado pelo gerador (padrão: claude-opus-5-5)
# ANTHROPIC_MODEL=claude-opus-5-5

# Postgres (no Railway, use a variável de referência ${{Postgres.DATABASE_URL}})
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hooks

# Opcional: protege o app inteiro com senha (HTTP Basic Auth, qualquer usuário)
# APP_PASSWORD=
